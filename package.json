{
  "name": "cresslet",
  "version": "0.5.0",
  "description": "Cresslet SDK and CLI: import your app's db, files and secrets; create, run, and deploy small web apps.",
  "license": "MIT",
  "keywords": [
    "cresslet",
    "cli",
    "deploy",
    "hosting",
    "web-apps",
    "sdk"
  ],
  "type": "module",
  "bin": {
    "cresslet": "dist/bin/cresslet.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./vite": {
      "types": "./dist/lib/vite.d.ts",
      "default": "./dist/lib/vite.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/sdk/index.d.ts",
  "files": [
    "dist/bin",
    "dist/lib",
    "dist/sdk"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/cresslet-cli.git"
  },
  "homepage": "https://cresslet.dev",
  "bugs": {
    "url": "https://github.com/ODumpling/cresslet-cli/issues"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sdk.json && node --experimental-strip-types scripts/check-ts.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "less": "^4.9.1",
    "postcss": "^8.5.33",
    "sass": "^1.108.2",
    "svelte": "^5.59.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vue": "^3.5.46"
  }
}
