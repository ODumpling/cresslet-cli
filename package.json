{
  "name": "cresslet",
  "version": "0.2.0",
  "description": "Cresslet SDK and CLI: import your app's db, files and secrets; create, run, and deploy small web apps.",
  "license": "MIT",
  "keywords": [
    "cresslet",
    "cli",
    "deploy",
    "hosting",
    "web-apps",
    "sdk"
  ],
  "type": "module",
  "bin": {
    "cresslet": "bin/cresslet.js"
  },
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "default": "./sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./sdk/index.d.ts",
  "files": [
    "bin",
    "lib",
    "sdk"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/cresslet-cli.git"
  },
  "homepage": "https://cresslet.dev",
  "bugs": {
    "url": "https://github.com/ODumpling/cresslet-cli/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "less": "^4.9.1",
    "postcss": "^8.5.33",
    "sass": "^1.108.2",
    "svelte": "^5.59.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  }
}
